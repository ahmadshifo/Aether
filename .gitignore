# Ignore secrets, dependencies, caches, build products and locally stored personal images/audio.

# Virtual environment
.venv/
venv/

# Python cache
__pycache__/
*.pyc
.pytest_cache/

# Private environment configuration
.env
.env.*

# Keep example configuration
!.env.example

# Generated images and temporary data
stored_frames/
temp/
output/

# Local database files
*.db
*.sqlite3

# IDE files
.vscode/
.idea/

# Dependencies and build output
node_modules/
dist/

# Logs and system files
*.log
.DS_Store

# Local data and recordings; the dashboard's mock data folder is source code
data/
!web/dashboard/src/data/
recordings/

# Claude Code local settings
.claude
