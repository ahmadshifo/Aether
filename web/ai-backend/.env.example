# Member 2: template for the AI backend's settings. Copy it to .env and fill in the secrets there (never here).

# Answers: which AI looks at the camera frames. AI_PROVIDER is gemini or openai.
# Get a Gemini key at https://aistudio.google.com/apikey. Free-tier content is used by Google to improve its
# products, so use a paid key for real users.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# OpenAI is kept as an option; empty means it is not used.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini

# Member 3's multimedia service (camera frames and search).
MULTIMEDIA_API_URL=http://localhost:8003

# The multimedia MySQL database (npm start runs it on port 3307); the backend creates its login tables there.
# Defaults can come from multimedia/api/.env; these values override that file.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=aether_multimedia
MYSQL_USER=
MYSQL_PASSWORD=

# Signs the 15-minute login token (JWT). Any long random string; keep it secret and the same across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
