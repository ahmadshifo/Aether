# Member 2: non-secret variable template for the AI backend and its connection to the multimedia search API.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
MULTIMEDIA_API_URL=http://localhost:8003
QUESTION_HISTORY_PATH=./data/questions.sqlite3

# The multimedia MySQL database (see multimedia/database/README.md): the backend creates its login tables there.
# Use the same account as DATABASE_URL in multimedia/api/.env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=aether_multimedia
MYSQL_USER=
MYSQL_PASSWORD=

# Signs the 15-minute login token (JWT). Any long random string; keep it secret and the same across restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
