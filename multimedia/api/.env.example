# Member 3: configuration example; store real OCR/vision credentials and database password outside version control.

# Pretrained AI services
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# MySQL Community 8.0.17+ or 8.4 LTS (native Windows or optional Docker)
MYSQL_USER=multimedia_user
MYSQL_DATABASE=multimedia_project
MYSQL_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD
MYSQL_PORT=3306
# Required only by the optional MySQL Docker container
MYSQL_ROOT_PASSWORD=YOUR_SEPARATE_ROOT_PASSWORD
# URL-encode special characters in the password used in DATABASE_URL.
DATABASE_URL=mysql+pymysql://multimedia_user:YOUR_LOCAL_DATABASE_PASSWORD@localhost:3306/multimedia_project?charset=utf8mb4

# Multimedia API
MULTIMEDIA_API_HOST=0.0.0.0
MULTIMEDIA_API_PORT=8003

# Task 12 HTTP server: python -m api.main uses these local defaults.
# Explicit uvicorn --host/--port arguments override server binding separately.
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Authentication reuses the existing account backend's JWT_SECRET, read from
# web/ai-backend/.env when absent here. Supply the SAME secret in the process
# environment for deployments where that private file is not available.

# Local image storage
FRAME_STORAGE_PATH=./stored_frames

# Frame retention in hours
FRAME_RETENTION_HOURS=24

# Task 13: bounded local-video runs, using the existing Task 3 sampler.
# Interval must be at least 1 second. Max counts sampled frames, including rejects.
PIPELINE_SAMPLE_INTERVAL_SECONDS=1
PIPELINE_MAX_TEST_FRAMES=5

# Explicit foreground cleanup worker; no worker starts with the API.
RETENTION_BATCH_SIZE=100
RETENTION_CLEANUP_INTERVAL_MINUTES=15

# Task 11 search: time windows use captured_at; expiry uses expires_at.
SEARCH_LATEST_SECONDS=10
SEARCH_RECENT_SECONDS=120
SEARCH_DEFAULT_LIMIT=5
SEARCH_MAX_LIMIT=20
SEARCH_BATCH_SIZE=128
# Raw cosine threshold in [-1, 1]; blank disables filtering until calibrated.
SEARCH_MIN_SIMILARITY=
# Small deterministic exact-OCR-line boost; 0 disables it.
SEARCH_OCR_BOOST=0.1

# Member 1 streaming server
RTSP_STREAM_URL=rtsp://localhost:8554/live/SESSION_ID

# Task 14 reuses RTSP_STREAM_URL as the trusted session URL template.
# No second conflicting host/path setting. URL-encode optional RTSP credentials.
MEDIA_RTSP_TRANSPORT=tcp
LIVE_OPEN_TIMEOUT_SECONDS=5
LIVE_READ_TIMEOUT_SECONDS=10
LIVE_SAMPLE_INTERVAL_SECONDS=1
LIVE_QUEUE_SIZE=3
LIVE_RECONNECT_INITIAL_SECONDS=1
LIVE_RECONNECT_MAX_SECONDS=15
LIVE_MAX_RECONNECT_ATTEMPTS=8
LIVE_MAX_CANDIDATE_AGE_SECONDS=5
LIVE_MAX_CONSECUTIVE_FAILURES=3
LIVE_MAX_TEST_FRAMES=5
LIVE_TEST_DURATION_SECONDS=20
