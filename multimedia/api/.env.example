# Member 3: configuration example; store real OCR/vision credentials and database password outside version control.

# Pretrained AI services
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# MySQL Community Server 8.4 LTS (native Windows or optional Docker)
MYSQL_USER=multimedia_user
MYSQL_DATABASE=aether_multimedia
MYSQL_PASSWORD=YOUR_LOCAL_DATABASE_PASSWORD
MYSQL_PORT=3306
# Required only by the optional MySQL Docker container
MYSQL_ROOT_PASSWORD=YOUR_SEPARATE_ROOT_PASSWORD
# URL-encode special characters in the password used in DATABASE_URL.
DATABASE_URL=mysql+pymysql://multimedia_user:YOUR_LOCAL_DATABASE_PASSWORD@localhost:3306/aether_multimedia?charset=utf8mb4

# Multimedia API
MULTIMEDIA_API_HOST=0.0.0.0
MULTIMEDIA_API_PORT=8003
# Live video: read phone streams, blur faces (YuNet), keep frames in RAM for 2 minutes
MULTIMEDIA_INGEST=on
MULTIMEDIA_FACE_BLUR=on
# OCR + caption + embedding for frames an answer used (off = save without AI calls)
MULTIMEDIA_AI_ANALYSIS=on

# Frame image storage: "local" (folder below) or "s3" (RustFS object storage)
FRAME_STORAGE_BACKEND=local
FRAME_STORAGE_PATH=./stored_frames

# RustFS (S3-compatible), used only when FRAME_STORAGE_BACKEND=s3. Bucket stays private.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=aether-frames
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=YOUR_RUSTFS_ACCESS_KEY
S3_SECRET_ACCESS_KEY=YOUR_RUSTFS_SECRET_KEY

# Frame retention in hours
FRAME_RETENTION_HOURS=24

# Member 1 streaming server
RTSP_STREAM_URL=rtsp://localhost:8554/live/SESSION_ID
