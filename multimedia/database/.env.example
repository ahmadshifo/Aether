# Shared database settings: copy to multimedia/database/.env and fill in. Never commit the real .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=echosight

# The account every service connects with; setup.py creates it with this password.
MYSQL_USER=echosight_app
MYSQL_PASSWORD=

# Only setup.py uses the admin account. Leave the password empty to be asked for it instead.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
