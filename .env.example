# Shared Docker and host-service settings. Never commit .env.
# node scripts/configure-local.mjs generates random local credentials.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=aether_multimedia
MYSQL_USER=aether
MYSQL_PASSWORD=
DATABASE_URL=
JWT_SECRET=
FRAME_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=aether-frames
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
VOICE_SERVICE_URL=http://127.0.0.1:8001
STT_MODEL=small
TTS_VOICE=F1
VOICE_THREADS=4
# Optional physical adapter IPv4 address.
AETHER_LAN_HOST=
OCR_SERVICE_URL=http://127.0.0.1:8004
OCR_DEFAULT_LANGUAGE=en
OCR_MIN_CONFIDENCE=0.85
