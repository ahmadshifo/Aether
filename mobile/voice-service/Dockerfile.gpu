# Optional NVIDIA STT worker. CPU remains the default in docker-compose.yml.
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/models HF_HOME=/models/huggingface
COPY requirements.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements.txt
COPY app/ ./app/
CMD ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001", "--no-access-log"]
