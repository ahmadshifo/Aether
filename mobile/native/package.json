{
  "name": "aether-native",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/expo.mjs start --go --lan --port 8083",
    "start:dev": "node scripts/expo.mjs start --dev-client --lan --port 8083",
    "start:team": "node scripts/team-stack.mjs start",
    "services:team": "node scripts/team-stack.mjs services",
    "check:team": "node scripts/team-stack.mjs check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src App.tsx index.ts tests scripts",
    "test": "node --experimental-transform-types --test tests/*.test.mjs",
    "test:ui": "jest --runInBand",
    "audit": "node scripts/audit.mjs",
    "export": "node scripts/expo.mjs export --platform ios --platform android --output-dir dist",
    "config:check": "node scripts/expo.mjs config --type introspect"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-sharing": "~58.0.22",
    "expo-speech": "~58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-webrtc": "155.0.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "oxlint": "1.89.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "react-test-renderer": "19.3.0",
    "typescript": "6.0.3"
  }
}
