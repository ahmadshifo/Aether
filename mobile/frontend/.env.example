# Member 1: public (non-secret) frontend configuration with URLs for voice, AI and MediaMTX services.
VITE_VOICE_API_URL=http://localhost:8001
VITE_AI_API_URL=http://localhost:8002
VITE_MEDIA_WHIP_BASE_URL=http://localhost:8889

# Auth calls always use relative /api/v1/auth URLs. Set this SERVER-ONLY variable
# in the Vite process environment (PowerShell: $env:AUTH_PROXY_TARGET='...').
# AUTH_PROXY_TARGET=http://127.0.0.1:8002
# The existing backend separately needs AUTH_DB_PATH outside Git and
# AUTH_COOKIE_SECURE=true for HTTPS; false is only for isolated local HTTP tests.
