# Laptop LAN IP or trusted HTTPS signaling origin, never localhost on phone.
# Public build configuration: do not put secrets here.
EXPO_PUBLIC_MEDIAMTX_URL=
# Optional existing Member 2 API; blank uses clearly labeled demo answers.
EXPO_PUBLIC_AI_API_BASE_URL=
# Default false: OS speech service may use its network provider.
# true requires supported and installed on-device locale; no cloud fallback.
EXPO_PUBLIC_SPEECH_ON_DEVICE_ONLY=false
# Enables HTTP only for private LAN development builds. Rebuild after changing.
ECHOSIGHT_ALLOW_LAN_HTTP=0
